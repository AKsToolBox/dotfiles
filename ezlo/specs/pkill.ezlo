# Auto-generated spec for pkill

cmd pkill "pkill [options] <pattern>"
  opt -H --require-handler "match only if signal handler is present"
  opt -q --queue <value> "integer value to be sent with the signal"
  opt -e --echo "display what is killed"
  opt -c --count "count of matching processes"
  opt -f --full "use full process name to match"
  opt -g --pgroup "match listed process group IDs"
  opt -G --group "match real group IDs"
  opt -i --ignore-case "match case insensitively"
  opt -n --newest "select most recently started"
  opt -o --oldest "select least recently started"
  opt -O --older <seconds> "select where older than seconds"
  opt -P --parent "match only child processes of the given parent"
  opt -s --session "match session IDs"
  opt --signal <sig> "signal to send (either number or name)"
  opt -t --terminal "match by controlling terminal"
  opt -u --euid "match by effective IDs"
  opt -U --uid "match by real IDs"
  opt -x --exact "match exactly with the command name"
  opt -F --pidfile <file> "read PIDs from file"
  opt -L --logpidfile "fail if PID file is not locked"
  opt -r --runstates <state> "match runstates [D,S,Z,...]"
  opt -A --ignore-ancestors "exclude our ancestors from results"
  opt --cgroup "match by cgroup v2 names"
  opt --ns <pid> "match the processes that belong to the same"
  opt --nslist "list which namespaces will be considered for"
  opt -h --help "display this help and exit"
  opt -V --version "output version information and exit"
